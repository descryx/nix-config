# Background and foreground colors
background = #020202
foreground = #d1cfcf

palette = 0=#0a0a0a
palette = 1=#ff0000
palette = 2=#00cc66
palette = 3=#ffcc00
palette = 4=#ff66cc
palette = 5=#ff66cc
palette = 6=#cfbdbd
palette = 7=#f5f5f5

palette = 8=#444444
palette = 9=#ff0000
palette = 10=#00ff88
palette = 11=#ffe066
palette = 12=#ff99dd
palette = 13=#ff99dd
palette = 14=#d4bcbc
palette = 15=#ffffff

background-opacity = 0.70
# adjust-cell-height = -2

custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl
custom-shader-animation = always
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
confirm-close-surface = false
font-family = Cascadia Code
# font-family = inconsolata
font-size = 11

window-decoration = none

# keybind = super+g>shift+backslash=new_split:right
# keybind = super+g>minus=new_split:down

# keybind = super+g>h=goto_split:left
# keybind = super+g>l=goto_split:right
# keybind = super+g>j=goto_split:down
# keybind = super+g>k=goto_split:up

# keybind = super+g>z=toggle_split_zoom

# keybind = alt+g>h=resize_split:left,20
# keybind = alt+g>l=resize_split:right,20
# keybind = alt+g>j=resize_split:down,20
# keybind = alt+g>k=resize_split:up,20

theme = noctalia
