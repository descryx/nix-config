{
    "$schema": "https://opencode.ai/theme.json",
    "defs": {
        "bg": "#1a1a1a",
        "fg": "#f5f5f5",
        "comment": "#707070",
        "keyword": "#ff0000",
        "func": "#ffffff",
        "string": "#999999",
        "type": "#b8b8b8",
        "number": "#ee0000",
        "boolean": "#bb0000",
        "operator": "#ffffff",
        "variable": "#cccccc",
        "error": "#ff0000",
        "warn": "#858f3f",
        "info": "#664490",
        "git_add": "#4b824b",
        "git_delete": "#bb0000",
        "git_change": "#858f3f",
        "selection": "#333333",
        "menu_bg": "#141414",
        "split": "#2a2a2a",
        "punctuation": "#b8b8b8",
        "heading": "#f5f5f5",
        "link": "#a8a8a8",
        "macro": "#bb0000",
        "darkred": "#bb0000",
        "black": "#000000",
        "white": "#ffffff",
        "grey": "#707070",
        "lightgrey": "#cccccc"
    },
    "theme": {
        "primary": {
            "dark": "keyword",
            "light": "keyword"
        },
        "secondary": {
            "dark": "variable",
            "light": "variable"
        },
        "accent": {
            "dark": "func",
            "light": "func"
        },
        "error": {
            "dark": "error",
            "light": "error"
        },
        "warning": {
            "dark": "warn",
            "light": "warn"
        },
        "success": {
            "dark": "git_add",
            "light": "git_add"
        },
        "info": {
            "dark": "info",
            "light": "info"
        },
        "text": {
            "dark": "fg",
            "light": "fg"
        },
        "textMuted": {
            "dark": "comment",
            "light": "comment"
        },
        "background": {
            "dark": "none",
            "light": "none"
        },
        "backgroundPanel": {
            "dark": "black",
            "light": "black"
        },
        "backgroundElement": {
            "dark": "black",
            "light": "black"
        },
        "border": {
            "dark": "split",
            "light": "split"
