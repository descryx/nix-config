            "dark": "fg",
            "light": "fg"
        },
        "markdownHeading": {
            "dark": "heading",
            "light": "heading"
        },
        "markdownLink": {
            "dark": "link",
            "light": "link"
        },
        "markdownLinkText": {
            "dark": "warn",
            "light": "warn"
        },
        "markdownCode": {
            "dark": "string",
            "light": "string"
        },
        "markdownBlockQuote": {
            "dark": "comment",
            "light": "comment"
        },
