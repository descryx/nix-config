            "dark": "comment",
            "light": "comment"
        },
        "syntaxKeyword": {
            "dark": "keyword",
            "light": "keyword"
        },
        "syntaxFunction": {
            "dark": "func",
            "light": "func"
        },
        "syntaxVariable": {
            "dark": "variable",
            "light": "variable"
        },
        "syntaxString": {
            "dark": "string",
            "light": "string"
        },
        "syntaxNumber": {
            "dark": "number",
            "light": "number"
        },
        "syntaxType": {
            "dark": "type",
            "light": "type"
        },
        "syntaxOperator": {
            "dark": "operator",
            "light": "operator"
        },
        "syntaxPunctuation": {
            "dark": "punctuation",
            "light": "punctuation"
        }
