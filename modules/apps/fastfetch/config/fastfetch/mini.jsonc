{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "separator": ""
  },
  "logo": {
    "type": "auto",
    "height": 11,
    "source": "~/.config/fastfetch/pics/nix-snowflake-white.png",
    "color": {
      "1": "#ffffff",
      "2": "#ffffff",
      "3": "#ffffff",
      "4": "#ffffff",
      "5": "#ffffff"
    },
    "padding": {
      // "top": 0,
      "left": 1,
    }
  },
  "modules": [
    "break",
    {
      "type": "command",
      "key": "󰀄 USER",
      "keyColor": "#ffffff",
      "text": "echo $USER@$(hostnamectl hostname)"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#ffffff",
      "format": "{name} {version-id}"
    },
    {
      "type": "kernel",
      "key": " Ker",
      "keyColor": "#ffffff",
      // "text": "echo $(uname -r | cut -d- -f1) $(uname -m)"
    },
    {
      "type": "packages",
      "key": "󰏗 Pkgs",
      "keyColor": "#ffffff",
      "format": "{all}"
    },
    {
      "type": "terminal",
      "key": "󰆍 Term",
      "keyColor": "#ffffff",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#ffffff",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "keyColor": "#ffffff",
      "key": "󰥔 Up",
    },
    {
      "type": "disk",
      "keyColor": "#ffffff",
      "key": " Age",
            "folders": "/",
            "format": "{days} days",
    },
    {
      "type": "memory",
      "key": "󰍛 Mem",
      "keyColor": "#ffffff",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "folders": "/",
      // "key": "󰋊 SSD",
      "key": " Disk",
      "keyColor": "#ffffff",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "custom",
      "format": "\u001b[90m󱄅 \u001b[91m󱄅 \u001b[92m󱄅 \u001b[93m󱄅 \u001b[94m󱄅 \u001b[95m󱄅 \u001b[96m󱄅 \u001b[97m󱄅"
    },
    "break"
  ]
}
