{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/pics/cosmonaft2.png",
        "type": "kitty",
        "height": 30,
//        "height": 26,
        "padding": {
            "top": 1
        }
    },
    "general": {},
    "display": {
        "brightColor": "true",
        "separator": "",
        "constants": [
            "\u001b[59C",
            "\u001b[77D",
            "\u001b[88C",
            "\u001b[20D",
            "─────────────────────────────────────────────────────────────────────",
            "                                                              │",
            "                                        │"
        ],
        "key": {
            "width": 14
        }
    },
    "modules": [
        "break",
        {
          "type": "custom",
          "format": "╭──{$5}{$4}── {#black}󱄅 {#red}󱄅 {#green}󱄅 {#yellow}󱄅 {#blue}󱄅 {#magenta}󱄅 {#cyan}󱄅 {#white}󱄅{#38;2;255;255;255} ─╮",
          "outputColor": "38;2;255;255;255"
        },
        {
            "type": "os",
            "key": "│OS       {$6}",
            "keyColor": "38;2;255;255;255",
        },
        {
            "type": "host",
            "key": "│Host     {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "kernel",
            "key": "│Kernel   {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "uptime",
            "key": "│Uptime   {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "packages",
            "key": "│Packages {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "shell",
            "key": "│Shell    {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "terminal",
            "key": "│Terminal {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "command",
            "key": "│OS Age   {$6}",
            "keyColor": "38;2;255;255;255",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
        },
        {
            "type": "custom",
            "format": "├─{$5}─┤",
            "outputColor": "38;2;255;255;255"
        },
        {
            "type": "de",
            "key": "│DE{$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "wm",
            "key": "│WM       {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "wmtheme",
            "key": "│WM Theme{$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "theme",
            "key": "│Theme    {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "cursor",
            "key": "│Cursor   {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "icons",
            "key": "│Icons    {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "font",
            "key": "│Font     {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "terminalfont",
            "key": "│Term Font{$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "custom",
            "format": "├─{$5}─┤",
            "outputColor": "38;2;255;255;255"
        },
        {
            "type": "cpu",
            "key": "│CPU      {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "gpu",
            "key": "│GPU      {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "display",
            "key": "│Video    {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "sound",
            "key": "│Sound    {$6}",
            "keyColor": "38;2;255;255;255",
            "format": "{name}" ,
        },
        {
            "type": "sound",
            "key": "│Volume   {$6}",
            "keyColor": "38;2;255;255;255",
            "format": "{volume-percentage}%"
        },
        {
            "type": "memory",
            "key": "│Memory   {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "swap",
            "key": "│Swap     {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "disk",
            "key": "│Disk     {$6}",
            "keyColor": "38;2;255;255;255"
        },
        {
            "type": "custom",
            "format": "╰─{$5}─╯",
            "outputColor": "38;2;255;255;255"
        }
    ]
}
