// Made by MHIA
// Github: https://github.com/MHashir09
// Note: Do not tinker with the spaces I have put here,
// else the UI may break

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty",
      "source": "~/.config/fastfetch/pics/o.png",
      "height": 16,
      "padding": {
        "top":1,
        "right": 1,
        "left": 1
      }
    },
    "display": {
        "separator": "  ",
        "color": "white"
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────╮"
        },
        // {
            // "type": "custom",
            // "key": "│                                         │"
        // },
        {
            "type": "command",
            "key": "│Owner        ",
            // "text": "echo $USER | tr '[:lower:]' '[:upper:]'",
            "text": "echo $USER",
            "format": "{>22}│"
        },
        {
            "type": "custom",
            "key": "├─────────────────────────────────────┤"
        },
        {
            "type": "command",
            "key": "│CPU          ",
            "text": "lscpu | grep 'Model name' | sed -E 's/.*(i[0-9]-[0-9A-Za-z]+).*/\\1/'",
            "format": "{>22}│"
        },
        {
            "type": "gpu",
            "key": "│GPU          ",
            "format": "{>22}│"
        },
        {
            "type": "command",
            "key": "│Ram          ",
            "text": "free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{>22}│"
        },
        {
            "type": "swap",
            "key": "│Swap         ",
            "format": "{>22}│"
        },
        {
            "type": "command",
            "key": "│Disk         ",
            "text": "df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'",
            "format": "{>22}│"
        },
        // {
        //     "type": "custom",
        //     "key": "│                                     │"
        //     "key": "├─────────────────────────────────────┤"
        // },
        {
            "type": "os",
            "key": "│OS           ",
            "format": "{pretty-name>22}│"
        },
        {
            "type": "command",
            "key": "│Kernel       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "{>22}│"
        },
        {
            "type": "wm",
            "key": "│WM           ",
            "format": "{>22}│"
        },
        {
            "type": "terminal",
            "key": "│Terminal     ",
            "format": "{pretty-name>22}│"
        },
        {
            "type": "shell",
            "key": "│Shell        ",
            "format": "{pretty-name>22}│"
        },
        {
            "type": "terminalfont",
            "key": "│Font         ",
            "format": "{>22}│"
        },
        // {
            // "type": "custom",
            // "key": "│                                     │"
            // "key": "├─────────────────────────────────────┤"
        // },
        {
            "type": "packages",
            "key": "│Packages     ",
            "format": "{all>22}│"
        },
        // {
        //     "type": "command",
        //     "key": "│Uptime       ",
        //     "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
        //     "format": "{>22}│"
        // },
        // {
        //     "type": "uptime",
        //     "key": "│Up           ",
        //     "format": "{>17}{hours} {minutes}m│",
        // },
        {
	        "key": "│OS Age                      ",
            "type": "disk",
	        "folders": "/",
	        "format": "{days} days│"
	    },
 
        // {
        //     "type": "custom",
        //     "key": "│                                         │"
        // },
        // {
        //     "type": "command",
        //     "key": " ",
        //     // "shell": "/bin/zsh",
        //     "text": "echo '│     WE ARE LIBRE ! ── 我々は自由だ！    │'",
        //     "format": "{1}"
        // },
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────╯"
        },
        "break"
    ]
}
