binds {
    // Mod+Shift+Slash hotkey-overlay-title="Hotkey Overlay" { show-hotkey-overlay; }
    // #"Cheatsheet"
    Mod+F1 hotkey-overlay-title="Keymap Cheatsheet"{ spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    // #"Applications"
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Alt+B hotkey-overlay-title="Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Ctrl+B hotkey-overlay-title="Toggle Bar" { spawn-sh "noctalia msg bar-toggle"; }
    Mod+Shift+F hotkey-overlay-title="Yazi" { spawn-sh "ghostty -e yazi"; }
    Mod+Shift+B hotkey-overlay-title="Browser Zen" { spawn "zen"; }
    Mod+F3 hotkey-overlay-title="Witgets" { spawn-sh "noctalia msg desktop-widgets-toggle"; }
    Mod+Tab hotkey-overlay-title="Session" { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+WheelScrollUp    cooldown-ms=0 { spawn "/etc/profiles/per-user/descryx/bin/niri-zoomctl" "in"; }
    Mod+WheelScrollDown  cooldown-ms=0 { spawn "/etc/profiles/per-user/descryx/bin/niri-zoomctl" "out"; }
    Mod+TouchpadScrollUp    cooldown-ms=0 { spawn "/etc/profiles/per-user/descryx/bin/niri-zoomctl" "in"; }
    Mod+TouchpadScrollDown cooldown-ms=0 { spawn "/etc/profiles/per-user/descryx/bin/niri-zoomctl" "out"; }
    Mod+Z                 cooldown-ms=0 { spawn "/etc/profiles/per-user/descryx/bin/niri-zoomctl" "reset"; }

    Mod+X hotkey-overlay-title="Screen Toolkit" { spawn-sh "noctalia msg panel-toggle alexander/screen-toolkit:panel"; }
    Mod+Shift+X hotkey-overlay-title="Screen Toolkit Result" { spawn-sh "noctalia msg panel-toggle alexander/screen-toolkit:result"; }
    Mod+V hotkey-overlay-title="Clipboard" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Q hotkey-overlay-title="Whiteboard" { spawn-sh "wayscriber --daemon-toggle"; }
    Mod+F2 hotkey-overlay-title="Booo!~" { spawn-sh "ghostty --font-size=3 --fullscreen=true --command=\"ghostty +boo\""; }

    Mod+Ctrl+Space hotkey-overlay-title="Wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Alt+Space hotkey-overlay-title="Wallhaven Browser" { spawn-sh "noctalia msg panel-toggle noctalia/wallhaven:browser"; }
    Mod+Shift+Space hotkey-overlay-title="Video Wallpaper" { spawn-sh "noctalia msg panel-toggle noctalia/mpvpaper:picker"; }

    Mod+Y hotkey-overlay-title="Obsidian" { spawn "obsidian"; }
    Mod+Ctrl+Alt+H hotkey-overlay-title="AniLib" { spawn "google-chrome" "--app=https://animelib.org"; }
    Mod+M hotkey-overlay-title="SoundCloud" { spawn "google-chrome" "--app=https://soundcloud.com"; }

    // #"Window/Column Focus/Motions"
    Mod+W hotkey-overlay-title="Close Window" { close-window; }
    Mod+F hotkey-overlay-title="Fullscreen Window" { fullscreen-window; }
    Mod+Ctrl+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Alt+F hotkey-overlay-title="Maximize to Edges" { maximize-window-to-edges; }
    Mod+P hotkey-overlay-title="Toggle Overview" { toggle-overview; }

    Mod+O hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+O hotkey-overlay-title="Focus Float/Tile" { switch-focus-between-floating-and-tiling; }

    Mod+T hotkey-overlay-title="Toggle Tabbed" { toggle-column-tabbed-display; }

    Mod+Ctrl+K hotkey-overlay-title="Focus Window Up" { focus-window-up; }
    Mod+Ctrl+J hotkey-overlay-title="Focus Window Down" { focus-window-down; }
    Mod+H hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+L hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+K hotkey-overlay-title="Workspace Up" { focus-workspace-up; }
    Mod+J hotkey-overlay-title="Workspace Down" { focus-workspace-down; }

    // #"Monitor Management"
    Mod+Left hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Right hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    // Mod+Ctrl+J { focus-monitor-down; }
    // Mod+Ctrl+K    { focus-monitor-up; }
    Mod+Shift+Left hotkey-overlay-title="Move to Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Right hotkey-overlay-title="Move to Monitor Right" { move-column-to-monitor-right; }
    // Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    // Mod+Ctrl+Shift+K    { move-column-to-monitor-up; }


    // #"Window/Column Movement"
    Mod+Shift+H hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Shift+I hotkey-overlay-title="Move Window Down" { move-window-down; }
    Mod+Shift+U hotkey-overlay-title="Move Window Up" { move-window-up; }
    Mod+Shift+L hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Shift+K hotkey-overlay-title="Move to WS Up" { move-column-to-workspace-up; }
    Mod+Shift+J hotkey-overlay-title="Move to WS Down" { move-column-to-workspace-down; }
    Mod+BracketLeft hotkey-overlay-title="Consume/Expel Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/Expel Right" { consume-or-expel-window-right; }
    Mod+Comma hotkey-overlay-title="Consume Into Column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Expel From Column" { expel-window-from-column; }


    // #"Resize"
    Mod+Alt+H hotkey-overlay-title="Resize Left" { set-column-width "-5%"; }
    Mod+Alt+L hotkey-overlay-title="Resize Right" { set-column-width "+5%"; }
    Mod+Alt+K hotkey-overlay-title="Resize Down" { set-window-height "-5%"; }
    Mod+Alt+J hotkey-overlay-title="Resize Up" { set-window-height "+5%"; }
    Mod+R hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }

    // Floating window movement (monitor level)
    // Mod+Ctrl+Shift+H { move-window-to-monitor-left; }
    // Mod+Ctrl+Shift+J { move-window-to-monitor-down; }
    // Mod+Ctrl+Shift+K { move-window-to-monitor-up; }
    // Mod+Ctrl+Shift+L { move-window-to-monitor-right; }

    // #"Workspaces"
    Mod+1 hotkey-overlay-title="Workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Workspace 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="Workspace 10" { focus-workspace 10; }

    Mod+Shift+1 hotkey-overlay-title="Move to WS 1" { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="Move to WS 2" { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="Move to WS 3" { move-column-to-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title="Move to WS 4" { move-column-to-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title="Move to WS 5" { move-column-to-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title="Move to WS 6" { move-column-to-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title="Move to WS 7" { move-column-to-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title="Move to WS 8" { move-column-to-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title="Move to WS 9" { move-column-to-workspace 9; }
    Mod+Shift+0 hotkey-overlay-title="Move to WS 10" { move-column-to-workspace 10; }
    Mod+Ctrl+Alt+K hotkey-overlay-title="Move WS Up" { move-workspace-up ; }
    Mod+Ctrl+Alt+J hotkey-overlay-title="Move WS Down 1" { move-workspace-down ; }

    // #"Screenshots"
    Mod+S hotkey-overlay-title="Screenshot Region" { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+S hotkey-overlay-title="Screenshot Fullscreen" { spawn-sh "noctalia msg screenshot-fullscreen"; }


    // #"Media & Brightness"
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume Up" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume Down" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mic Mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness Up" { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Down" { spawn "brightnessctl" "set" "5%-"; }

    // #"Misc"
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Columns" { center-visible-columns; }
    Mod+Backspace allow-inhibiting=false hotkey-overlay-title="Toggle Inhibit" { toggle-keyboard-shortcuts-inhibit; } // i dont think this works
    Mod+Up hotkey-overlay-title="Switch Kbr Layout"{ switch-layout "next"; }
}
